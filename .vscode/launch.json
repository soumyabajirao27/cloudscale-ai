{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "jinja": true
    },
    {
      "name": "Frontend: Vite NEW UI (npm run dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend_new/pbl sem 5"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: FastAPI + NEW Vite UI (F5)",
      "configurations": [
        "Backend: FastAPI (uvicorn)",
        "Frontend: Vite NEW UI (npm run dev)"
      ]
    }
  ]
}
