{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: FastAPI (uvicorn)",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "backend",
        "clear": true
      },
      "problemMatcher": {
        "owner": "python",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Uvicorn running on.*",
          "endsPattern": ".*Application startup complete.*"
        }
      }
    },
    {
      "label": "Frontend: Vite UI (npm run dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "frontend",
        "clear": true
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE v.*",
          "endsPattern": ".*Local:\\s*http://localhost:3000.*"
        }
      }
    },
    {
      "label": "Start Both Servers (Backend + Frontend)",
      "dependsOn": [
        "Backend: FastAPI (uvicorn)",
        "Frontend: Vite UI (npm run dev)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
